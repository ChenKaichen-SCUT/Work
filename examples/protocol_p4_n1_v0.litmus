X86 protocol_p4_n1_v0
{ x0=0; x1=0; flag0=0; flag1=0; flag2=0; flag3=0; }
P0 | P1 | P2 | P3 ;
MOV [x0],$1 | MOV [x1],$1 | MOV [x0],$1 | MOV [x1],$1 ;
MOV EAX,[x1] | MOV EAX,[x0] | MOV [flag2],$1 | MOV [flag3],$1 ;
MOV [flag0],$1 | MOV [flag1],$1 | MOV EAX,[flag0] | MOV EAX,[flag0] ;
MOV EBX,[flag1] | MOV EBX,[flag0] | MOV EBX,[flag1] | MOV EBX,[flag1] ;
MOV ECX,[flag2] | MOV ECX,[flag2] | MOV ECX,[flag3] | MOV ECX,[flag2] ;
MOV EDX,[flag3] | MOV EDX,[flag3] | MFENCE | MFENCE ;
MFENCE | MFENCE |  |  ;
exists (0:EAX=0 /\ 0:EBX=1 /\ 0:ECX=1 /\ 0:EDX=1 /\ 1:EAX=0 /\ 1:EBX=1 /\ 1:ECX=1 /\ 1:EDX=1 /\ 2:EAX=1 /\ 2:EBX=1 /\ 2:ECX=1 /\ 3:EAX=1 /\ 3:EBX=1 /\ 3:ECX=1)
